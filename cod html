    <!-- JAVASCRIPT DE FUNCIONALIDADES E RESPOSTAS DA IA -->
    <script>
        // Menu Mobile Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Alternar Abas do Cadastro
        function switchTab(tab) {
            const btnDoar = document.getElementById('tab-doar');
            const btnReceber = document.getElementById('tab-receber');
            const formDoar = document.getElementById('form-doar');
            const formReceber = document.getElementById('form-receber');

            if (tab === 'doar') {
                btnDoar.className = "flex-1 py-4 px-6 text-center font-bold text-lg flex items-center justify-center gap-2 border-b-4 border-brand-orange text-brand-orange bg-orange-50/50 transition-all";
                btnReceber.className = "flex-1 py-4 px-6 text-center font-bold text-lg flex items-center justify-center gap-2 text-gray-500 border-b-4 border-transparent hover:text-brand-green transition-all";
                formDoar.classList.remove('hidden');
                formReceber.classList.add('hidden');
            } else {
                btnReceber.className = "flex-1 py-4 px-6 text-center font-bold text-lg flex items-center justify-center gap-2 border-b-4 border-brand-green text-brand-green bg-green-50/50 transition-all";
                btnDoar.className = "flex-1 py-4 px-6 text-center font-bold text-lg flex items-center justify-center gap-2 text-gray-500 border-b-4 border-transparent hover:text-brand-orange transition-all";
                formReceber.classList.remove('hidden');
                formDoar.classList.add('hidden');
            }
        }

        function scrollToCadastro(tab) {
            switchTab(tab);
            document.getElementById('cadastro').scrollIntoView({ behavior: 'smooth' });
        }

        // Envio de Formulário e Modal de Alerta
        function submitCadastro(event, tipo) {
            event.preventDefault();
            const alertModal = document.getElementById('alert-sucesso');
            const titulo = document.getElementById('alert-titulo');
            const msg = document.getElementById('alert-mensagem');

            if (tipo === 'doador') {
                titulo.innerText = "Doação Cadastrada!";
                msg.innerText = "Sua doação foi registrada no sistema. Uma ONG parceira ou nossa equipe entrará em contato via WhatsApp para combinar a retirada ou entrega.";
            } else {
                titulo.innerText = "Solicitação Recebida!";
                msg.innerText = "Recebemos o seu pedido com prioridade. Nossa equipe identificará a cozinha comunitária ou banco de alimentos mais próximo do seu endereço.";
            }

            alertModal.classList.remove('hidden');
            event.target.reset();
        }

        function closeAlert() {
            document.getElementById('alert-sucesso').classList.add('hidden');
        }

        // Filtro de ONGs
        function filterOngs() {
            const input = document.getElementById('search-ong').value.toLowerCase();
            const cards = document.querySelectorAll('.ong-card');

            cards.forEach(card => {
                const searchData = card.getAttribute('data-search').toLowerCase();
                const cardText = card.innerText.toLowerCase();

                if (searchData.includes(input) || cardText.includes(input)) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            });
        }

        // Toggle Chat Flutuante
        function toggleFloatingChat() {
            const box = document.getElementById('floating-chat-box');
            box.classList.toggle('hidden');
            box.classList.toggle('flex');
        }

        // MOTOR DE RESPOSTAS DA IA (CONSERVAÇÃO DE ALIMENTOS & PROJETO)
        function generateAIAnswer(question) {
            const q = question.toLowerCase();

            if (q.includes('marmita') || q.includes('prato pronto') || q.includes('comida pronta')) {
                return "🍱 **Validade de Marmitas:**<br>• Na geladeira (até 4°C): Consumir em no máximo **3 a 4 dias**.<br>• No congelador (-18°C): Dura de **30 a 90 dias** com segurança.<br>⚠️ *Dica:* Espere a marmita esfriar (no máximo 2h fora da geladeira) antes de tampar e congelar.";
            } 
            else if (q.includes('ovo') || q.includes('ovos')) {
                return "🥚 **Teste do Ovo Fresco:**<br>Coloque o ovo em um copo com água:<br>1. **Afundou no fundo:** Está bem fresco.<br>2. **Ficou em pé no fundo:** Ainda pode consumir, mas consuma rápido.<br>3. **Boiou na superfície:** ❌ **Estragado!** Descarte imediatamente pois acumulou gases de deterioração.";
            }
            else if (q.includes('vencido') || q.includes('vencimento') || q.includes('passou da validade')) {
                return "⚠️ **Regras para Doação e Consumo:**<br>• **Alimentos vencidos NÃO devem ser doados.**<br>• Produtos com *'Consumir preferencialmente antes de'* (como biscoitos e secos) às vezes mantêm segurança por poucos dias após a data se a embalagem estiver lacrada, mas para doação oficial aceitamos apenas dentro da validade.";
            }
            else if (q.includes('arroz') || q.includes('feijão') || q.includes('feijao')) {
                return "🌾 **Conservação de Arroz e Feijão:**<br>• Na geladeira: Duram de **4 a 5 dias** bem tampados.<br>• Congelados: O feijão dura até **3 meses** (de preferência sem tempero forte). O arroz congelado dura até **2 meses**.<br>💡 *Sinal de azedo:* Cheiro forte, textura pegajosa ou espuma ao esquentar indicam deterioração.";
            }
            else if (q.includes('leite')) {
                return "🥛 **Validade do Leite:**<br>• Leite UHT aberto: Deve ser mantido em geladeira e consumido em até **3 dias**.<br>• Se notar talhado, cheiro azedo ou grumos ao ferver, descarte.";
            }
            else if (q.includes('ong') || q.includes('onde') || q.includes('bairro') || q.includes('ponto')) {
                return "📍 **Encontrando ONGs:**<br>Você pode usar a barra de busca na nossa seção **'ONGs & Pontos'** nesta página! Digite seu bairro ou zona (ex: Centro, Itaquera, Santana) para ver os locais de coleta e entrega.";
            }
            else if (q.includes('doar') || q.includes('como doar')) {
                return "❤️ **Como Doar:**<br>Clique no botão **'Quero Doar'** no topo do site e preencha o formulário com o tipo de alimento (secos, marmitas ou hortifrúti). Conectaremos você à ONG mais próxima!";
            }
            else if (q.includes('casca') || q.includes('aproveitamento') || q.includes('talos')) {
                return "🌱 **Aproveitamento Integral:**<br>• **Talos de couve/espinafre:** Refogue com alho ou bata no feijão.<br>• **Cascas de banana:** Podem virar doces ou 'carne louca' vegana rica em fibras.<br>• **Cascas de batata:** Lave bem, tempere com azeite e sal e asse no forno como chips!";
            }
            else {
                return "😊 **Dica de Segurança Alimentar:**<br>Sempre observe os 3 sentidos antes de consumir ou doar qualquer item: **Cheiro, Aspecto visual (presença de mofo ou cor estranha) e Textura**.<br><br>Se tiver dúvidas sobre um item específico, pergunte por exemplo: *'como conservar feijão'*, *'teste do ovo'* ou *'validade de marmitas'*!";
            }
        }

        // Lógica do Chat Embutido
        function handleSendEmbeddedChat(e) {
            e.preventDefault();
            const input = document.getElementById('embedded-user-input');
            const msg = input.value.trim();
            if (!msg) return;

            appendMessage('embedded-chat-messages', msg, 'user');
            input.value = '';

            setTimeout(() => {
                const botReply = generateAIAnswer(msg);
                appendMessage('embedded-chat-messages', botReply, 'bot');
            }, 500);
        }

        // Lógica do Chat Flutuante
        function handleSendFloatingChat(e) {
            e.preventDefault();
            const input = document.getElementById('floating-user-input');
            const msg = input.value.trim();
            if (!msg) return;

            appendMessage('floating-chat-messages', msg, 'user');
            input.value = '';

            setTimeout(() => {
                const botReply = generateAIAnswer(msg);
                appendMessage('floating-chat-messages', botReply, 'bot');
            }, 500);
        }

        function askQuickPrompt(text) {
            document.getElementById('embedded-user-input').value = text;
            handleSendEmbeddedChat(new Event('submit'));
        }

        function appendMessage(containerId, text, sender) {
            const container = document.getElementById(containerId);
            const wrapper = document.createElement('div');
            
            if (sender === 'user') {
                wrapper.className = "flex justify-end";
                wrapper.innerHTML = `
                    <div class="bg-brand-orange text-white px-4 py-2.5 rounded-2xl rounded-tr-none max-w-[80%] text-sm shadow">
                        ${text}
                    </div>
                `;
            } else {
                wrapper.className = "flex items-start gap-2.5";
                wrapper.innerHTML = `
                    <div class="w-7 h-7 rounded-full bg-brand-green text-white flex items-center justify-center text-xs font-bold shrink-0">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="bg-white border border-gray-200 text-gray-800 p-3.5 rounded-2xl rounded-tl-none max-w-[85%] text-sm shadow-sm leading-relaxed">
                        ${text}
                    </div>
                `;
            }

            container.appendChild(wrapper);
            container.scrollTop = container.scrollHeight;
        }
    </script>
