</head>
<body class="bg-gray-50 text-gray-800 font-sans flex flex-col min-h-screen">
 <script src="script.js"></script>

    <!-- CABEÇALHO / NAVBAR -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur shadow-md border-b-4 border-brand-orange">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <a href="#inicio" class="flex items-center gap-2 group">
                    <div class="w-11 h-11 rounded-full bg-brand-orange text-white flex items-center justify-center text-xl font-black shadow-lg group-hover:scale-105 transition-transform">
                        <i class="fa-solid fa-utensils"></i>
                    </div>
                    <span class="text-2xl font-extrabold tracking-tight text-brand-orange">FOME<span class="text-brand-green">ZERO</span></span>
                </a>

                <!-- Nav Desktop -->
                <nav class="hidden md:flex space-x-8 items-center font-semibold text-gray-700">
                    <a href="#inicio" class="hover:text-brand-orange transition-colors">Início</a>
                    <a href="#cadastro" class="hover:text-brand-orange transition-colors">Cadastro</a>
                    <a href="#ongs" class="hover:text-brand-orange transition-colors">ONGs & Pontos</a>
                    <a href="#chat-ia" class="hover:text-brand-orange transition-colors">IA Tira-Dúvidas</a>
                    <a href="#impacto" class="hover:text-brand-orange transition-colors">Impacto</a>
                </nav>

                <!-- Botões de Ação Rapida Header -->
                <div class="hidden sm:flex items-center gap-3">
                    <button onclick="scrollToCadastro('doar')" class="bg-brand-orange hover:bg-brand-darkOrange text-white font-bold py-2.5 px-5 rounded-full shadow-md hover:shadow-lg transition-all text-sm flex items-center gap-2">
                        <i class="fa-solid fa-heart"></i> Quero Doar
                    </button>
                    <button onclick="scrollToCadastro('receber')" class="bg-brand-green hover:bg-brand-darkGreen text-white font-bold py-2.5 px-5 rounded-full shadow-md hover:shadow-lg transition-all text-sm flex items-center gap-2">
                        <i class="fa-solid fa-hand-holding-hand"></i> Preciso de Ajuda
                    </button>
                </div>

                <!-- Menu Mobile Btn -->
                <button id="mobile-menu-btn" onclick="toggleMobileMenu()" class="md:hidden text-gray-700 text-2xl focus:outline-none">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- Menu Mobile Dropdown -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-gray-200 px-4 pt-2 pb-6 space-y-3">
            <a href="#inicio" onclick="toggleMobileMenu()" class="block font-medium text-gray-700 hover:text-brand-orange">Início</a>
            <a href="#cadastro" onclick="toggleMobileMenu()" class="block font-medium text-gray-700 hover:text-brand-orange">Cadastro</a>
            <a href="#ongs" onclick="toggleMobileMenu()" class="block font-medium text-gray-700 hover:text-brand-orange">ONGs & Pontos</a>
            <a href="#chat-ia" onclick="toggleMobileMenu()" class="block font-medium text-gray-700 hover:text-brand-orange">IA Tira-Dúvidas</a>
            <div class="pt-2 flex flex-col gap-2">
                <button onclick="scrollToCadastro('doar'); toggleMobileMenu();" class="w-full bg-brand-orange text-white font-bold py-2.5 rounded-lg text-center">Quero Doar Alimentos</button>
                <button onclick="scrollToCadastro('receber'); toggleMobileMenu();" class="w-full bg-brand-green text-white font-bold py-2.5 rounded-lg text-center">Preciso de Alimentação</button>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section id="inicio" class="gradient-hero text-white py-20 lg:py-28 px-4 relative overflow-hidden">
        <div class="max-w-5xl mx-auto text-center space-y-6 relative z-10">
            <span class="inline-block bg-brand-yellow text-gray-900 text-xs md:text-sm font-extrabold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-md">
                <i class="fa-solid fa-bolt mr-1"></i> Ação Social Direta e Inteligente
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                Nenhuma Comida no Lixo, Nenhum Prato Vazio!
            </h1>
            <p class="text-lg sm:text-xl max-w-3xl mx-auto text-gray-100 font-normal leading-relaxed">
                Conectamos restaurantes, feiras, supermercados e doadores individuais a comunidades e ONGs locais. Além disso, nossa IA ajuda você a reaproveitar alimentos e checar validade com segurança!
            </p>
            
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pt-4">
                <button onclick="scrollToCadastro('doar')" class="w-full sm:w-auto bg-brand-orange hover:bg-brand-darkOrange text-white text-lg font-bold py-4 px-8 rounded-xl shadow-xl hover:scale-105 transition-all flex items-center justify-center gap-3">
                    <i class="fa-solid fa-box-tissue text-2xl"></i> Fazer Doação de Alimentos
                </button>
                <button onclick="scrollToCadastro('receber')" class="w-full sm:w-auto bg-brand-green hover:bg-brand-darkGreen text-white text-lg font-bold py-4 px-8 rounded-xl shadow-xl hover:scale-105 transition-all flex items-center justify-center gap-3">
                    <i class="fa-solid fa-utensils text-2xl"></i> Solicitar Refeição / Ajuda
                </button>
            </div>
        </div>
    </section>

    <!-- METRICAS DE IMPACTO -->
    <section id="impacto" class="bg-white py-12 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
            <div class="p-4 rounded-2xl bg-brand-lightOrange border border-orange-100">
                <div class="text-3xl lg:text-4xl font-black text-brand-darkOrange">+120.000</div>
                <div class="text-sm font-bold text-gray-600 uppercase mt-1">Refeições Servidas</div>
            </div>
            <div class="p-4 rounded-2xl bg-brand-lightGreen border border-green-100">
                <div class="text-3xl lg:text-4xl font-black text-brand-darkGreen">48 Toneladas</div>
                <div class="text-sm font-bold text-gray-600 uppercase mt-1">Alimentos Resgatados</div>
            </div>
            <div class="p-4 rounded-2xl bg-amber-50 border border-amber-100">
                <div class="text-3xl lg:text-4xl font-black text-brand-amber">85 ONGs</div>
                <div class="text-sm font-bold text-gray-600 uppercase mt-1">Pontos de Coleta</div>
            </div>
            <div class="p-4 rounded-2xl bg-blue-50 border border-blue-100">
                <div class="text-3xl lg:text-4xl font-black text-blue-600">100% Gratuito</div>
                <div class="text-sm font-bold text-gray-600 uppercase mt-1">Rede Solidária</div>
            </div>
        </div>
    </section>

    <!-- SEÇÃO DE CADASTRO DUPLO (DOADOR VS BENEFICIÁRIO) -->
    <section id="cadastro" class="py-16 px-4 max-w-4xl mx-auto">
        <div class="text-center mb-10">
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900">Portal de Cadastro</h2>
            <p class="text-gray-600 mt-2 text-lg">Escolha como você deseja interagir com o Projeto Fome Zero</p>
        </div>

        <!-- ABAS DE NAVEGAÇÃO DO FORMULÁRIO -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
            <div class="flex border-b border-gray-200">
                <button id="tab-doar" onclick="switchTab('doar')" class="flex-1 py-4 px-6 text-center font-bold text-lg flex items-center justify-center gap-2 border-b-4 border-brand-orange text-brand-orange bg-orange-50/50 transition-all">
                    <i class="fa-solid fa-gift"></i> Quero Doar (Doador)
                </button>
                <button id="tab-receber" onclick="switchTab('receber')" class="flex-1 py-4 px-6 text-center font-bold text-lg flex items-center justify-center gap-2 text-gray-500 border-b-4 border-transparent hover:text-brand-green transition-all">
                    <i class="fa-solid fa-hand-holding-heart"></i> Preciso de Ajuda (Receber)
                </button>
            </div>

            <!-- FORMULÁRIO DOADOR -->
            <form id="form-doar" onsubmit="submitCadastro(event, 'doador')" class="p-6 sm:p-10 space-y-6">
                <div class="bg-orange-50 border-l-4 border-brand-orange p-4 rounded-r-lg text-sm text-orange-900">
                    <p class="font-bold"><i class="fa-solid fa-circle-info mr-1"></i> Atenção Doador:</p>
                     Aceitamos cestas básicas, alimentos não-perecíveis, hortifrúti fresco e refeições preparadas (seguindo as normas de higiene).
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Nome Completo / Empresa *</label>
                        <input type="text" required placeholder="Ex: Mercado Silva ou João Pedro" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-orange focus:border-brand-orange outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Telefone / WhatsApp *</label>
                        <input type="tel" required placeholder="(11) 99999-9999" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-orange focus:border-brand-orange outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Tipo de Alimento a Doar *</label>
                        <select required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-orange focus:border-brand-orange outline-none bg-white">
                            <option value="">Selecione uma opção...</option>
                            <option value="nao-perecivel">Alimentos Não-Perecíveis (Arroz, Feijão, Macarrão)</option>
                            <option value="marmitas">Refeições Preparadas / Marmitas Frescas</option>
                            <option value="hortifruti">Frutas, Legumes e Verduras (Hortifrúti)</option>
                            <option value="padaria">Pães e Itens de Padaria</option>
                            <option value="outro">Cestas Básicas / Diversos</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Quantidade Estimada (kg / unidades) *</label>
                        <input type="text" required placeholder="Ex: 10kg, 20 marmitas, 5 cestas" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-orange focus:border-brand-orange outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Endereço de Coleta ou Ponto de Entrega *</label>
                    <input type="text" required placeholder="Rua, número, bairro e cidade" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-orange focus:border-brand-orange outline-none">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Observações / Horário de Retirada</label>
                    <textarea rows="3" placeholder="Informações adicionais sobre o alimento ou melhor horário..." class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-orange focus:border-brand-orange outline-none"></textarea>
                </div>

                <button type="submit" class="w-full bg-brand-orange hover:bg-brand-darkOrange text-white font-black py-4 px-6 rounded-xl text-lg shadow-lg hover:shadow-xl transition-all">
                    <i class="fa-solid fa-paper-plane mr-2"></i> Confirmar Doação
                </button>
            </form>

            <!-- FORMULÁRIO BENEFICIÁRIO (RECEBER) -->
            <form id="form-receber" onsubmit="submitCadastro(event, 'beneficiario')" class="p-6 sm:p-10 space-y-6 hidden">
                <div class="bg-green-50 border-l-4 border-brand-green p-4 rounded-r-lg text-sm text-green-900">
                    <p class="font-bold"><i class="fa-solid fa-heart-pulse mr-1"></i> Cadastro Seguro e Confidencial:</p>
                    Seus dados serão utilizados apenas para conectar você ao ponto de distribuição ou ONG mais próxima de sua casa.
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Nome Completo *</label>
                        <input type="text" required placeholder="Seu nome" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Telefone / WhatsApp de Contato *</label>
                        <input type="tel" required placeholder="(11) 99999-9999" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Pessoas na Família / Residência *</label>
                        <select required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none bg-white">
                            <option value="1">Apenas eu (1 pessoa)</option>
                            <option value="2-3">2 a 3 pessoas</option>
                            <option value="4-5">4 a 5 pessoas</option>
                            <option value="6+">6 ou mais pessoas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Nível de Urgência *</label>
                        <select required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none bg-white">
                            <option value="urgente">Urgente (Sem refeição para hoje)</option>
                            <option value="medio">Moderado (Preciso de cesta para a semana)</option>
                            <option value="continuo">Acompanhamento contínuo</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Endereço Completo e Bairro *</label>
                    <input type="text" required placeholder="Nome da rua, número, bairro e cidade" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Alguma restrição alimentar ou necessidade especial?</label>
                    <textarea rows="3" placeholder="Ex: Bebês na casa precisando de leite, pessoa com diabetes, intolerância a glúten..." class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none"></textarea>
                </div>

                <button type="submit" class="w-full bg-brand-green hover:bg-brand-darkGreen text-white font-black py-4 px-6 rounded-xl text-lg shadow-lg hover:shadow-xl transition-all">
                    <i class="fa-solid fa-hand-holding-heart mr-2"></i> Solicitar Apoio Alimentar
                </button>
            </form>
        </div>

        <!-- MENSAGEM DE SUCESSO SIMULADA -->
        <div id="alert-sucesso" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl max-w-md w-full p-8 text-center space-y-4 shadow-2xl transform transition-all">
                <div class="w-16 h-16 bg-green-100 text-brand-green rounded-full flex items-center justify-center text-3xl mx-auto">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h3 class="text-2xl font-black text-gray-900" id="alert-titulo">Cadastro Realizado!</h3>
                <p class="text-gray-600" id="alert-mensagem">Obrigado por se juntar à corrente Fome Zero. Em breve entraremos em contato via WhatsApp/Telefone.</p>
                <button onclick="closeAlert()" class="w-full bg-brand-green text-white font-bold py-3 rounded-xl hover:bg-brand-darkGreen transition-colors">
                    Entendido
                </button>
            </div>
        </div>
    </section>

    <!-- MAPA / DIRETÓRIO DE ONGS E PONTOS DE COLETA -->
    <section id="ongs" class="py-16 bg-gray-100 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-10">
                <h2 class="text-3xl sm:text-4xl font-black text-gray-900">ONGs e Cozinhas Solidárias Parceiras</h2>
                <p class="text-gray-600 mt-2">Encontre pontos de entrega de alimentos ou postos de distribuição de refeições gratuitas perto de você.</p>
                
                <!-- Barra de Busca -->
                <div class="mt-6 flex gap-2 max-w-md mx-auto">
                    <div class="relative flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-400"></i>
                        <input type="text" id="search-ong" onkeyup="filterOngs()" placeholder="Buscar por bairro, nome ou cidade..." class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-orange outline-none shadow-sm">
                    </div>
                </div>
            </div>

            <!-- CARDS DE ONGS -->
            <div id="ongs-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="ong-card bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all border border-gray-100 flex flex-col justify-between" data-search="centro cozinha solidaria sp sao paulo prato">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-orange-100 text-brand-darkOrange text-xs font-bold px-3 py-1 rounded-full uppercase">Cozinha Solidária</span>
                            <span class="text-xs font-semibold text-green-600 bg-green-50 px-2.5 py-1 rounded-md"><i class="fa-solid fa-clock mr-1"></i>Aberto Agora</span>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">Cozinha Comunidade Viva</h3>
                        <p class="text-sm text-gray-600 mb-4"><i class="fa-solid fa-location-dot text-brand-orange mr-1.5"></i> Rua Santa Ifigênia, 450 - Centro, São Paulo - SP</p>
                        <p class="text-sm text-gray-500 mb-4">Servindo almoço comunitário gratuito diariamente das 11h30 às 13h30. Aceita doações de alimentos frescos e marmitas.</p>
                    </div>
                    <div class="pt-4 border-t border-gray-100 flex justify-between items-center text-sm font-semibold">
                        <span class="text-gray-600"><i class="fa-solid fa-phone mr-1 text-gray-400"></i> (11) 3222-1090</span>
                        <a href="https://maps.google.com" target="_blank" class="text-brand-orange hover:text-brand-darkOrange">Ver no Mapa <i class="fa-solid fa-arrow-up-right-from-square text-xs ml-1"></i></a>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="ong-card bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all border border-gray-100 flex flex-col justify-between" data-search="zona leste banco alimentos itaquera cesta">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-green-100 text-brand-darkGreen text-xs font-bold px-3 py-1 rounded-full uppercase">Banco de Alimentos</span>
                            <span class="text-xs font-semibold text-gray-500 bg-gray-100 px-2.5 py-1 rounded-md"><i class="fa-solid fa-clock mr-1"></i>Abre às 08h</span>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">Banco Solidário ZL</h3>
                        <p class="text-sm text-gray-600 mb-4"><i class="fa-solid fa-location-dot text-brand-orange mr-1.5"></i> Av. Itaquera, 1200 - Itaquera, São Paulo - SP</p>
                        <p class="text-sm text-gray-500 mb-4">Triagem e distribuição de cestas básicas para famílias cadastradas. Ponto principal de arrecadação de secos e molhados.</p>
                    </div>
                    <div class="pt-4 border-t border-gray-100 flex justify-between items-center text-sm font-semibold">
                        <span class="text-gray-600"><i class="fa-solid fa-phone mr-1 text-gray-400"></i> (11) 2055-8844</span>
                        <a href="https://maps.google.com" target="_blank" class="text-brand-orange hover:text-brand-darkOrange">Ver no Mapa <i class="fa-solid fa-arrow-up-right-from-square text-xs ml-1"></i></a>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="ong-card bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all border border-gray-100 flex flex-col justify-between" data-search="zona norte santana instuto abrigo marmita">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full uppercase">Instituto Social</span>
                            <span class="text-xs font-semibold text-green-600 bg-green-50 px-2.5 py-1 rounded-md"><i class="fa-solid fa-clock mr-1"></i>Aberto Agora</span>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">Instituto Prato Cheio Norte</h3>
                        <p class="text-sm text-gray-600 mb-4"><i class="fa-solid fa-location-dot text-brand-orange mr-1.5"></i> Rua Voluntários da Pátria, 890 - Santana, SP</p>
                        <p class="text-sm text-gray-500 mb-4">Distribuição de sopas e refeições noturnas a partir das 19h. Apoio a mães solo e idosos.</p>
                    </div>
