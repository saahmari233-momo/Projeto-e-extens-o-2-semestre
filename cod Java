function renderOngs(filtradas) {
    const listContainer = document.getElementById('ongList');
    if (!listContainer) return;

    listContainer.innerHTML = '';
    
    if (filtradas.length === 0) {
        listContainer.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #718096;">Nenhuma ONG encontrada para este local.</p>';
        return;
    }

    filtradas.forEach(ong => {
        const card = document.createElement('div');
        card.className = 'ong-card';
        card.innerHTML = `
            <h3>${ong.nome}</h3>
            <p><strong>Bairro:</strong> ${ong.bairro}</p>
            <p><strong>Cidade:</strong> ${ong.cidade}</p>
            <p><strong>Tipo:</strong> ${ong.tipo}</p>
            <p class="phone">📞 ${ong.tel}</p>
        `;
        listContainer.appendChild(card);
    });
}

function filtrarOngs() {
    const termo = document.getElementById('searchOng').value.toLowerCase();
    const resultado = ongsData.filter(ong => 
        ong.bairro.toLowerCase().includes(termo) || 
        ong.cidade.toLowerCase().includes(termo) ||
        ong.nome.toLowerCase().includes(termo)
    );
    renderOngs(resultado);
}


function setPerfil(perfil) {
    const formGroupAlimentos = document.getElementById('groupAlimentos');
    const formGroupFamilia = document.getElementById('groupFamilia');
    const inputPerfil = document.getElementById('perfilInput');
    
    const btnDoador = document.getElementById('btnPerfilDoador');
    const btnBeneficiario = document.getElementById('btnPerfilBeneficiario');

    inputPerfil.value = perfil;

    if (perfil === 'doador') {
        btnDoador.classList.add('active');
        btnBeneficiario.classList.remove('active');
        
        formGroupAlimentos.style.display = 'block';
        formGroupFamilia.style.display = 'none';
    } else {
        btnBeneficiario.classList.add('active');
        btnDoador.classList.remove('active');
        
        formGroupAlimentos.style.display = 'none';
        formGroupFamilia.style.display = 'block';
    }
}

function submeterCadastro(event) {
    event.preventDefault();
    const perfil = document.getElementById('perfilInput').value;
    const nome = document.getElementById('nome').value;

    if (perfil === 'doador') {
        alert(`Obrigado pelo cadastro, ${nome}! Entraremos em contato para organizar a coleta dos alimentos.`);
    } else {
        alert(`Cadastro realizado com sucesso, ${nome}! Entraremos em contato indicando o ponto de retirada mais próximo.`);
    }

    event.target.reset();
}

