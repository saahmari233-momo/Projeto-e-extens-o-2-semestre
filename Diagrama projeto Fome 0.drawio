        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Usuario {\n    +int id\n    +String nome\n    +String email\n    +String telefone\n    +String endereco\n    +String tipoUsuario\n    +cadastrar()\n    +fazerLogin()\n    +solicitarAlimento()\n  }\n\n  class Instituicao {\n    +int id\n    +String nome\n    +String CNPJ\n    +String endereco\n    +String telefone\n    +cadastrarDoacao()\n    +receberSolicitacao()\n    +confirmarEntrega()\n  }\n\n  class Doacao {\n    +int id\n    +String alimento\n    +int quantidade\n    +Date validade\n    +Date dataCadastro\n    +String status\n    +cadastrar()\n    +atualizarStatus()\n    +cancelar()\n  }\n\n  class Solicitacao {\n    +int id\n    +Date data\n    +int quantidade\n    +String status\n    +String observacao\n    +criar()\n    +cancelar()\n    +acompanharStatus()\n  }\n\n  class PontoDistribuicao {\n    +int id\n    +String nome\n    +String endereco\n    +String horarioFuncionamento\n    +int capacidade\n    +cadastrarPonto()\n    +atualizarHorario()\n  }\n\n  class Notificacao {\n    +int id\n    +String mensagem\n    +Date data\n    +Boolean lida\n    +enviar()\n    +marcarComoLida()\n  }\n\n  Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Solicitacao : realiza\n  Instituicao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Doacao : realiza\n  Solicitacao \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Instituicao : atendida por\n  Doacao \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; PontoDistribuicao : encaminhada para\n  Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notificacao : recebe&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wh73uZRQZjH3brXCAe9t-25">
